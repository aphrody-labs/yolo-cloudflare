# Declarative definition of the yolo-cloudflare cluster. Every script in deploy/ reads this file.
# Addresses come from the WireGuard mesh inventory (fleet.toml, mesh 10.200.77.0/24).
# Ports were checked free on every host with `ss -ltn` on 2026-11-04 before first use.

NODES="vps bunos prod"
FIRST_NODE=vps
BUILD_HOST=vps
BUILD_CHECKOUT='~/src/yolo-work/yolo-cloudflare'

MESH_IP_vps=10.200.77.1
MESH_IP_bunos=10.200.77.3
MESH_IP_prod=10.200.77.5

# Garage capacity per node (layout weight; the bucket quota below is the hard cap).
GARAGE_CAPACITY_vps=20G
GARAGE_CAPACITY_bunos=5G
GARAGE_CAPACITY_prod=20G
S3_BUCKET=yolo-cf-test
S3_BUCKET_QUOTA=5GiB
S3_KEY_NAME=yolo-cf-app

PORT_WORKERD=17080
PORT_GW_WORKERS=17081
PORT_GW_S3=17082
PORT_GW_DB=17083
PORT_RQLITE_HTTP=17401
PORT_RQLITE_RAFT=17402
PORT_S3=17900
PORT_GARAGE_RPC=17901
PORT_GARAGE_ADMIN=17903

# Pinned upstream artifacts. SHA-256 values are the GitHub release asset digests, except Garage,
# which publishes no checksum: its value was cross-checked against the binary inside the official
# image dxflrs/garage:v2.5.0 (sha256:677e5b75...) and both matched.
WORKERD_VERSION=v1.20261104.1
WORKERD_URL=https://github.com/cloudflare/workerd/releases/download/v1.20261104.1/workerd-linux-64.gz
WORKERD_SHA256=4e7e6600b23b9e8ea464b57af69f930f6e1901316404b6e35aa254e666304cbb
CLOUDFLARED_VERSION=2026.10.7
CLOUDFLARED_URL=https://github.com/cloudflare/cloudflared/releases/download/2026.10.7/cloudflared-linux-amd64
CLOUDFLARED_SHA256=1f99fb518b83dec2ba8d870a7cc991d82a77e6196295a3d2754ba17ab9f91872
RQLITE_VERSION=v10.6.6
RQLITE_URL=https://github.com/rqlite/rqlite/releases/download/v10.6.6/rqlite-v10.6.6-linux-amd64.tar.gz
RQLITE_SHA256=b0fdc2d526b03c0d933e27bf84f53d447791d1a6e331e74fa2013750bf621aba
GARAGE_VERSION=v2.5.0
GARAGE_URL=https://garagehq.deuxfleurs.fr/_releases/v2.5.0/x86_64-unknown-linux-musl/garage
GARAGE_SHA256=2ff667286217cd73ebcb1c03af993822365000441dfe31a80cb64c5189a9dea8
WRANGLER_VERSION=4.157.0
WORKER_COMPAT_DATE=2026-11-01
